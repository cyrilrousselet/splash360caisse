{
    "name": "youtill",
    "productName": "YouTill",
    "description": "Cash app developed by Aqua Forte",
    "version": "0.1.0",
    "private": true,
    "author": {
        "name": "Cyril Rousselet",
        "email": "hello@aqua-forte.net",
        "url": "https://www.aqua-forte.net"
    },
    "build": {
        "appId": "net.aqua-forte.youtill",
        "productName": "YouTill",
        "copyright": "Copyright © 2019 ${author}",
        "mac": {
            "category": "public.app-category.business"
        },
        "win": {
            "target": "nsis"
        },
        "files": [
            "build/**/*",
            "node_modules/**/*"
        ],
        "directories": {
            "buildResources": "build"
        }
    },
    "license": "MIT",
    "homepage": "./",
    "main": "public/electron.js",
    "dependencies": {
        "@babel/runtime": "^7.6.3",
        "@date-io/date-fns": "^1.3.13",
        "@material-ui/core": "^4.6.0",
        "@material-ui/icons": "^4.5.1",
        "@material-ui/pickers": "^3.2.8",
        "connected-react-router": "^6.5.2",
        "date-fns": "^2.0.0-beta.5",
        "drag-scroll-provider": "^1.0.6",
        "eiphop": "^1.0.11",
        "electron-is-dev": "^1.1.0",
        "electron-log": "^3.0.7",
        "electron-store": "^4.0.0",
        "escpos": "^2.5.2",
        "express": "^4.17.1",
        "lodash": "^4.17.15",
        "nedb": "^1.8.0",
        "nedb-promises": "^4.0.0",
        "node-sass-chokidar": "^1.3.5",
        "react": "^16.9.0",
        "react-dom": "^16.9.0",
        "react-hot-loader": "^4.12.11",
        "react-localization": "^1.0.15",
        "react-redux": "^7.1.0",
        "react-router-dom": "^5.0.1",
        "react-scripts": "^3.3.0",
        "react-tabs-redux": "^4.0.0",
        "redux": "^4.0.4",
        "redux-thunk": "^2.3.0",
        "sweetalert2": "^8.17.1",
        "sweetalert2-react-content": "^1.1.0"
    },
    "scripts": {
        "build-css": "node-sass-chokidar src/ -o src/",
        "watch-css": "npm run build-css && node-sass-chokidar src/ -o src/ --watch --recursive",
        "start": "rescripts start",
        "build": "rescripts build",
        "test": "rescripts test",
        "eject": "react-scripts eject",
        "electron-dev": "concurrently \"yarn start && yarn watch-css\" \"wait-on http://localhost:3000 && electron .\"",
        "postinstall": "electron-builder install-app-deps",
        "preelectron-pack": "yarn build",
        "electron-pack-mac": "electron-builder -m",
        "electron-pack-win": "electron-builder -w",
        "electron-pack-linux": "electron-builder -l"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/cli": "^7.5.5",
        "@babel/core": "^7.5.5",
        "@babel/plugin-syntax-top-level-await": "^7.7.4",
        "@babel/preset-flow": "^7.0.0",
        "@rescripts/cli": "^0.0.11",
        "@rescripts/rescript-env": "^0.0.10",
        "babel7-jest": "^1.0.1",
        "concurrently": "^4.1.2",
        "electron": "^6.0.2",
        "electron-builder": "^21.2.0",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.2",
        "flow-bin": "^0.106.0",
        "react-test-renderer": "^16.12.0",
        "redux-logger": "^3.0.6",
        "wait-on": "^3.3.0"
    }
}
