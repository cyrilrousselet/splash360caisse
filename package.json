{
    "name": "splash360",
    "productName": "Splash360",
    "description": "Cash application",
    "version": "0.1.203231818",
    "private": true,
    "author": {
        "name": "Splash360",
        "email": "contact@splash360.fr",
        "url": "https://www.splash360.fr"
    },
    "build": {
        "appId": "fr.splash360.splash",
        "productName": "Splash360",
        "copyright": "Copyright © 2020 Splash360",
        "mac": {
            "icon": "build/icon.icns",
            "category": "public.app-category.business"
        },
        "win": {
            "icon": "build/icon.ico",
            "target": "nsis"
        },
        "files": [
            "build/**/*",
            "node_modules/**/*"
        ],
        "directories": {
            "buildResources": "build"
        }
    },
    "license": "MIT",
    "homepage": "./",
    "main": "public/electron.js",
    "dependencies": {
        "@babel/runtime": "^7.6.3",
        "@cerati/react-mercure": "0.0.1",
        "@date-io/date-fns": "^1.3.13",
        "@material-ui/core": "^4.6.0",
        "@material-ui/icons": "^4.9.1",
        "@material-ui/lab": "^4.0.0-alpha.56",
        "@material-ui/pickers": "^3.2.10",
        "@pelevesque/canonicalize-string": "0.0.6",
        "axios": "^0.19.2",
        "babel-eslint": "^10.1.0",
        "chart.js": "^2.9.3",
        "connected-react-router": "^6.5.2",
        "cors": "^2.8.5",
        "date-fns": "^2.10.0",
        "diacritics": "^1.3.0",
        "drag-scroll-provider": "^1.0.6",
        "eiphop": "^1.0.11",
        "electron-is-dev": "^1.1.0",
        "electron-log": "^3.0.7",
        "electron-promise-ipc": "^2.0.1",
        "electron-store": "^4.0.0",
        "escpos": "^3.0.0-alpha.4",
        "escpos-network": "^3.0.0-alpha.5",
        "escpos-serialport": "^3.0.0-alpha.4",
        "escpos-usb": "^3.0.0-alpha.4",
        "eventsource": "^1.0.7",
        "express": "^4.17.1",
        "get-pixels": "^3.3.2",
        "lodash": "^4.17.15",
        "lodash-id": "^0.14.0",
        "lodash-move": "^1.1.1",
        "lowdb": "^1.0.0",
        "mkdirp": "^1.0.4",
        "mongoose": "^5.10.9",
        "node-machine-id": "^1.1.12",
        "node-sass-chokidar": "^1.3.5",
        "nodemon": "^2.0.2",
        "qrcode": "^1.4.4",
        "react": "^16.9.0",
        "react-chartjs-2": "^2.9.0",
        "react-dom": "^16.9.0",
        "react-encrypt": "^1.0.1",
        "react-hot-loader": "^4.12.11",
        "react-localization": "^1.0.15",
        "react-redux": "^7.1.0",
        "react-router-dom": "^5.0.1",
        "react-scripts": "^3.3.0",
        "react-simple-keyboard": "^2.3.72",
        "react-smooth-dnd": "^0.11.1",
        "react-tabs-redux": "^4.0.0",
        "realm": "^10.0.1",
        "redux": "^4.0.4",
        "redux-socket.io": "^1.4.0",
        "redux-thunk": "^2.3.0",
        "simple-keyboard": "^2.29.51",
        "simple-keyboard-layouts": "^1.13.25",
        "simple-oauth2": "^3.4.0",
        "socket.io": "^2.3.0",
        "socket.io-client": "^2.3.0",
        "sweetalert2": "^8.17.1",
        "sweetalert2-react-content": "^1.1.0"
    },
    "scripts": {
        "build-css": "node-sass-chokidar src/ -o src/",
        "watch-css": "npm run build-css && node-sass-chokidar src/ -o src/ --watch --recursive",
        "start": "rescripts start",
        "build": "rescripts build",
        "test": "rescripts test",
        "eject": "react-scripts eject",
        "electron-dev": "concurrently \"yarn start && yarn watch-css\" \"wait-on http://localhost:3000 && electron .\"",
        "postinstall": "electron-builder install-app-deps",
        "preelectron-pack": "yarn build",
        "electron-pack-mac": "electron-builder -m",
        "electron-pack-win": "electron-builder -w",
        "electron-pack-linux": "electron-builder -l"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/cli": "^7.5.5",
        "@babel/core": "^7.5.5",
        "@babel/plugin-syntax-top-level-await": "^7.7.4",
        "@babel/plugin-transform-classes": "^7.10.4",
        "@babel/preset-flow": "^7.0.0",
        "@rescripts/cli": "^0.0.11",
        "@rescripts/rescript-env": "^0.0.10",
        "babel7-jest": "^1.0.1",
        "concurrently": "^4.1.2",
        "electron": "^6.0.2",
        "electron-builder": "^21.2.0",
        "electron-rebuild": "^1.11.0",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.2",
        "flow-bin": "^0.106.0",
        "react-test-renderer": "^16.12.0",
        "reactotron-react-js": "^3.3.7",
        "reactotron-redux": "^3.1.3",
        "redux-logger": "^3.0.6",
        "wait-on": "^3.3.0"
    },
    "babel": {
        "plugins": [
            [
                "@babel/plugin-proposal-class-properties",
                {
                    "loose": true
                }
            ],
            [
                "@babel/plugin-transform-classes",
                {
                    "loose": true
                }
            ]
        ]
    }
}
